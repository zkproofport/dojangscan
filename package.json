{
  "name": "dojang-scan",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4317",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:live": "node --import tsx scripts/check-live.mjs",
    "test:zk": "node --import tsx scripts/prove-balance.mjs",
    "test:zk:onchain": "node --import tsx scripts/test-zk-onchain.mjs",
    "zk:compile": "node scripts/compile-balance.mjs",
    "format:workspace": "prettier --write components/workspace.tsx components/balance-studio.tsx components/contract-console.tsx components/transaction-review.tsx lib/workspace.ts lib/transactions.ts lib/balance-*.ts lib/contract-console.ts src/workers/*.ts scripts/*balance*.mjs scripts/test-zk-onchain.mjs tests/transactions.test.ts"
  },
  "dependencies": {
    "@aztec/bb.js": "1.0.0-nightly.20250723",
    "@noir-lang/noir_js": "1.0.0-beta.8",
    "@zkproofport-app/sdk": "^0.3.1",
    "buffer": "6.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ethers": "^6.16.0",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "3.6.2",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
